<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grok Stream - Streaming IA Gratuit</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #0a0a0a; color: white; font-family: system-ui; }
        .video-card { transition: all 0.3s; }
        .video-card:hover { transform: scale(1.05); }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; }
    </style>
</head>
<body class="min-h-screen">
    <!-- Header -->
    <header class="bg-black border-b border-gray-800 py-4 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="text-3xl">🎥</span>
                <h1 class="text-3xl font-bold text-red-600">GROK STREAM</h1>
            </div>
            <input id="search" type="text" placeholder="Rechercher films, séries, vidéos IA..." 
                   class="bg-gray-900 text-white px-6 py-3 rounded-full w-96 focus:outline-none focus:ring-2 focus:ring-red-600">
            <div class="flex items-center gap-6 text-xl">
                <span>🏠</span>
                <span>🔥</span>
                <span>👤</span>
            </div>
        </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 py-8">
        <h2 class="text-3xl font-bold mb-6">🔥 Tendances du moment</h2>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
            <!-- Video 1 -->
            <div class="video-card bg-gray-900 rounded-xl overflow-hidden cursor-pointer" onclick="playVideo(1)">
                <img src="https://picsum.photos/id/1015/400/225" class="w-full h-48 object-cover">
                <div class="p-4">
                    <h3 class="font-semibold">Inception - Version IA</h3>
                    <p class="text-gray-400 text-sm">2h 28min • Sci-Fi</p>
                </div>
            </div>
            
            <!-- Video 2 -->
            <div class="video-card bg-gray-900 rounded-xl overflow-hidden cursor-pointer" onclick="playVideo(2)">
                <img src="https://picsum.photos/id/201/400/225" class="w-full h-48 object-cover">
                <div class="p-4">
                    <h3 class="font-semibold">Cyberpunk City Night</h3>
                    <p class="text-gray-400 text-sm">4K • Animation IA</p>
                </div>
            </div>
            
            <!-- Video 3 -->
            <div class="video-card bg-gray-900 rounded-xl overflow-hidden cursor-pointer" onclick="playVideo(3)">
                <img src="https://picsum.photos/id/237/400/225" class="w-full h-48 object-cover">
                <div class="p-4">
                    <h3 class="font-semibold">The Last Samurai</h3>
                    <p class="text-gray-400 text-sm">2h 34min • Action</p>
                </div>
            </div>
            
            <!-- Ajoute d'autres cartes si tu veux -->
        </div>
    </div>

    <!-- Modal Player -->
    <div id="playerModal" class="modal flex items-center justify-center">
        <div class="max-w-5xl w-full px-4">
            <button onclick="closePlayer()" class="absolute top-8 right-8 text-4xl text-white hover:text-red-600">✕</button>
            <video id="mainVideo" controls autoplay class="w-full rounded-2xl shadow-2xl" style="max-height: 80vh;">
                Votre navigateur ne supporte pas la vidéo.
            </video>
            <div class="text-center mt-4 text-gray-400">
                Grok Stream - Streaming gratuit par IA
            </div>
        </div>
    </div>

    <script>
        function playVideo(id) {
            const video = document.getElementById('mainVideo');
            const modal = document.getElementById('playerModal');
            
            if (id === 1) video.src = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4";
            else if (id === 2) video.src = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4";
            else video.src = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/Sintel.mp4";
            
            modal.style.display = "flex";
            video.play();
        }
        
        function closePlayer() {
            const modal = document.getElementById('playerModal');
            const video = document.getElementById('mainVideo');
            video.pause();
            modal.style.display = "none";
        }
        
        // Recherche basique
        document.getElementById('search').addEventListener('keyup', function(e) {
            if (e.key === "Enter") alert("Recherche : " + this.value + " (fonctionnalité à venir !)");
        });
    </script>
</body>
</html>
